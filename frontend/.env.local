# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Noble Nests Co"

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: local | cloudflare-r2
STORAGE_PROVIDER=local

# Cloudflare R2 — replace with real values for production
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
R2_BUCKET=noblenests-prod-assets
R2_REGION=auto
R2_PUBLIC_URL=https://cdn.noblenests.co
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ─── Security ─────────────────────────────────────────────────────────────────
# Admin API key for protected endpoints (POST /api/properties, GET /api/leads)
ADMIN_API_KEY=replace-with-a-long-random-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://noblenests.co

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# RESEND_API_KEY=re_XXXXXXXXXXXX
# EMAIL_FROM=noreply@noblenests.co
# EMAIL_TO_ADVISOR=invest@noblenests.co

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noblenestsco?schema=public"
